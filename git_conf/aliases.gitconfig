[alias]

# Taken from https://stackoverflow.com/questions/6245570
curr-branch = symbolic-ref --short HEAD

default-remote = "!git config --get branch.$(git rev-parse --abbrev-ref HEAD).remote"

merged = branch --merged  # optional branch argument
retrack = "!f() { git branch --force \"$1\" \"origin/$1\"; }; f"
detach = checkout --detach HEAD

# Delete the current branch but stay on its commit, detached. Complements
# `detach`. Uses -d, so it refuses if the branch has commits its upstream lacks.
yeet-branch = "!f() { b=$(git branch --show-current); [ -n \"${b}\" ] || { echo 'Not on a branch' >&2; return 1; }; git detach && git branch -d \"${b}\"; }; f"

# Clears the mismatched upstream (e.g. after a branch rename), so a plain
# `push` auto-creates a same-named branch on the remote instead of erroring
# (requires push.autoSetupRemote, set globally in main.gitconfig)
unmoor = branch --unset-upstream

fetchp = fetch --prune
prune-remote = remote prune  # requires a remote name argument

# Point the local tracking ref (refs/remotes/<remote>/HEAD) at whichever branch
# the remote currently reports as its default. Because git never updates this on
# its own (not even on fetch), it goes stale when the remote's default changes.
sync-head = "!f() { git remote set-head \"$1\" --auto; }; f"  # requires a remote name argument

# Does a comparison relative to the current HEAD
delete-merged = "!git for-each-ref --format=\"%(refname:short)\" refs/heads | xargs git branch -d"

resign = commit --am --no-edit -S
sign-from = rebase --force -S  # requires a commit hash argument

# Safer force-push: refuse if remote has commits not in local history.
fpush = push --force-with-lease --force-if-includes

# Try the commit again if it failed due to signing issues, recovering the old commit message
rcommit = !"git commit -t .git/COMMIT_EDITMSG"

fixup = commit -a --fixup  # requires a commit hash argument
autosq = rebase -i --autosquash  # requires a commit hash argument

absorbs = absorb -r --base  # requires a commit hash argument
ama = commit --am -a

# Targeted cherry-pick: replay only <commit>'s change to the given path(s)
# onto the working tree, with a 3-way merge fallback when it won't apply
# cleanly. Unlike `checkout <commit> -- path`, this applies the commit's
# delta rather than overwriting with the whole file at that commit.
pluck-file = "!f() { rev=\"$1\"; shift; git show \"$rev\" -- \"$@\" | git apply --3way; }; f"

raw-commit = log --format=%B -n 1  # optional commit hash argument

# Submodule aliases
sm-sink = submodule update --init --recursive  # git's default: sync to committed hashes
sm-swim = submodule update --remote --rebase  # advance to branch tip regardless of committed hash

# Log views, using the formats in [pretty] below. The date style lives here
# because a format's %ad/%cd always follow the date setting. It's set via -c
# rather than --date, because an explicit --date turns -g selectors from
# HEAD@{n} into HEAD@{<date>}.
twoline = -c 'log.date=format:%Y-%m-%d %H:%M %z' log --pretty=twoline
dossier = -c 'log.date=format:%Y-%m-%d %H:%M %z' log --pretty=dossier --stat
exhibit = -c 'log.date=format:%Y-%m-%d %H:%M %z' show --pretty=dossier --stat -p

# Commits reachable only from the reflog, such as pre-rebase versions
strays = log --oneline --reflog --not --branches --tags --remotes

# Clone variants
panto = clone --recurse-submodules
clone-arid = clone --depth=10 --single-branch --recurse-submodules --shallow-submodules

# For common typos
pulll = pull
commi = commit
statu = status
lo = log
sho = show

[pretty]

# %gd (the HEAD@{n} selector) only expands during a reflog walk, such as with -g
twoline = tformat:%C(yellow)%h%C(reset)%C(auto)%d% gd%C(reset) %s%n└─ %C(bold blue)%an%C(reset), %C(green)%ad%C(reset) (%ar) · committed by %C(bold blue)%cn%C(reset), %C(green)%cd%C(reset)

# Like fuller, but each identity shares a line with its date. Uses format:
# rather than tformat: because %B already ends with a newline.
dossier = format:%C(yellow)commit %H%C(reset)%C(auto)%d% gd%C(reset)%nAuthor: %an <%ae>, %ad (%ar)%nCommit: %cn <%ce>, %cd (%cr)%n%n%w(0,4,4)%B
